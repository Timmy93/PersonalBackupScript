### [MANDATORY] 
# RESTIC_REPOSITORY -> Dove si trova il repository: s3:... per un bucket, rclone:... per un site rclone, /media/... un path per un repository locale
###
export RESTIC_REPOSITORY=""

### [MANDATORY] - Opzioni alternative
# RESTIC_PASSWORD_FILE -> File contenente la password del repository
###
export RESTIC_PASSWORD_FILE=""
# RESTIC_PASSWORD -> Password del repository
export RESTIC_PASSWORD=""

#AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY -> [Opzionale] Solo per accedere a bucket S3
#export AWS_ACCESS_KEY_ID=""
#export AWS_SECRET_ACCESS_KEY=""

# URL per segnalare lo stato del backup (rimuovere eventuali parametri GET)
UPTIME_URL="https://status.sericloud.it/api/push/8UyEPqrCWQy8lQCwYkxbJPlCcgMDav1F"